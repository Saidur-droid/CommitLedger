module CommitLedger where

-- CommitLedger intentionally models a demo/test settlement asset.
-- It does not claim to transfer fiat, Canton Coin, or production funds.

data GitHubPullRequestRef = GitHubPullRequestRef
  with
    repository : Text
    prNumber : Int
    prUrl : Text
    headSha : Text
    baseBranch : Text
  deriving (Eq, Show)

data MergeEvidence = MergeEvidence
  with
    repository : Text
    issueNumber : Int
    prNumber : Int
    prUrl : Text
    headSha : Text
    baseBranch : Text
    merged : Bool
    mergedAt : Text
    evidenceHash : Text
  deriving (Eq, Show)

template Bounty
  with
    maintainer : Party
    verifier : Party
    bountyId : Text
    repository : Text
    issueNumber : Int
    issueUrl : Text
    title : Text
    rewardAmount : Decimal
    rewardUnit : Text
  where
    signatory maintainer
    observer verifier

    ensure rewardAmount > 0.0 && issueNumber > 0

    choice Bounty_Cancel : ()
      controller maintainer
      do pure ()

template ClaimRequest
  with
    contributor : Party
    maintainer : Party
    bountyId : Text
    contributorGithub : Text
  where
    signatory contributor
    observer maintainer

    choice ClaimRequest_Reject : ()
      controller maintainer
      do pure ()

    choice ClaimRequest_Accept : ContractId ClaimedBounty
      with
        bountyCid : ContractId Bounty
      controller maintainer
      do
        bounty <- fetch bountyCid
        assertMsg "claim bounty id must match" (bounty.bountyId == bountyId)
        assertMsg "claim maintainer must match bounty maintainer" (bounty.maintainer == maintainer)
        archive bountyCid
        create ClaimedBounty with
          maintainer = bounty.maintainer
          verifier = bounty.verifier
          contributor
          contributorGithub
          bountyId = bounty.bountyId
          repository = bounty.repository
          issueNumber = bounty.issueNumber
          issueUrl = bounty.issueUrl
          title = bounty.title
          rewardAmount = bounty.rewardAmount
          rewardUnit = bounty.rewardUnit

template ClaimedBounty
  with
    maintainer : Party
    verifier : Party
    contributor : Party
    contributorGithub : Text
    bountyId : Text
    repository : Text
    issueNumber : Int
    issueUrl : Text
    title : Text
    rewardAmount : Decimal
    rewardUnit : Text
  where
    signatory maintainer
    observer contributor, verifier

    choice ClaimedBounty_SubmitPullRequest : ContractId SubmittedBounty
      with
        pullRequest : GitHubPullRequestRef
      controller contributor
      do
        assertMsg "pull request repository must match bounty repository"
          (pullRequest.repository == repository)
        assertMsg "pull request number must be positive" (pullRequest.prNumber > 0)
        assertMsg "pull request URL is required" (pullRequest.prUrl /= "")
        assertMsg "pull request head SHA is required" (pullRequest.headSha /= "")
        assertMsg "pull request base branch is required" (pullRequest.baseBranch /= "")
        create SubmittedBounty with
          maintainer
          verifier
          contributor
          contributorGithub
          bountyId
          repository
          issueNumber
          issueUrl
          title
          rewardAmount
          rewardUnit
          pullRequest

template SubmittedBounty
  with
    maintainer : Party
    verifier : Party
    contributor : Party
    contributorGithub : Text
    bountyId : Text
    repository : Text
    issueNumber : Int
    issueUrl : Text
    title : Text
    rewardAmount : Decimal
    rewardUnit : Text
    pullRequest : GitHubPullRequestRef
  where
    signatory contributor
    observer maintainer, verifier

    -- A maintainer can return the exact submitted PR for revision.
    -- The reason is preserved as the exercise argument in the Canton transaction.
    choice SubmittedBounty_ReturnForRevision : ContractId ClaimedBounty
      with
        reason : Text
      controller maintainer
      do
        assertMsg "revision reason is required" (reason /= "")
        create ClaimedBounty with
          maintainer
          verifier
          contributor
          contributorGithub
          bountyId
          repository
          issueNumber
          issueUrl
          title
          rewardAmount
          rewardUnit

    choice SubmittedBounty_VerifyMerged : ContractId VerifiedBounty
      with
        evidence : MergeEvidence
      controller verifier
      do
        assertMsg "GitHub evidence must report a merged pull request" evidence.merged
        assertMsg "evidence repository mismatch" (evidence.repository == pullRequest.repository)
        assertMsg "evidence issue number mismatch" (evidence.issueNumber == issueNumber)
        assertMsg "evidence PR number mismatch" (evidence.prNumber == pullRequest.prNumber)
        assertMsg "evidence URL mismatch" (evidence.prUrl == pullRequest.prUrl)
        assertMsg "evidence head SHA mismatch" (evidence.headSha == pullRequest.headSha)
        assertMsg "evidence base branch mismatch" (evidence.baseBranch == pullRequest.baseBranch)
        assertMsg "merge timestamp is required" (evidence.mergedAt /= "")
        assertMsg "evidence hash is required" (evidence.evidenceHash /= "")
        create VerifiedBounty with
          maintainer
          verifier
          contributor
          contributorGithub
          bountyId
          repository
          issueNumber
          issueUrl
          title
          rewardAmount
          rewardUnit
          pullRequest
          evidence

template VerifiedBounty
  with
    maintainer : Party
    verifier : Party
    contributor : Party
    contributorGithub : Text
    bountyId : Text
    repository : Text
    issueNumber : Int
    issueUrl : Text
    title : Text
    rewardAmount : Decimal
    rewardUnit : Text
    pullRequest : GitHubPullRequestRef
    evidence : MergeEvidence
  where
    signatory verifier
    observer maintainer, contributor

    choice VerifiedBounty_Settle : ContractId SettlementReceipt
      with
        settledAt : Time
        settlementRef : Text
      controller maintainer
      do
        assertMsg "settlement reference is required" (settlementRef /= "")
        create SettlementReceipt with
          maintainer
          verifier
          contributor
          contributorGithub
          bountyId
          repository
          issueNumber
          pullRequest
          rewardAmount
          rewardUnit
          evidenceHash = evidence.evidenceHash
          settledAt
          settlementRef

template SettlementReceipt
  with
    maintainer : Party
    verifier : Party
    contributor : Party
    contributorGithub : Text
    bountyId : Text
    repository : Text
    issueNumber : Int
    pullRequest : GitHubPullRequestRef
    rewardAmount : Decimal
    rewardUnit : Text
    evidenceHash : Text
    settledAt : Time
    settlementRef : Text
  where
    signatory maintainer
    observer contributor, verifier
