# Canton JSON Ledger API.
CANTON_JSON_API_URL=http://localhost:3975
CANTON_PACKAGE_ID=

# Three distinct Canton parties are required for the full competition proof.
CANTON_MAINTAINER_PARTY=
CANTON_CONTRIBUTOR_PARTY=
CANTON_VERIFIER_PARTY=

# LocalNet may use one token with rights for all demo parties.
CANTON_TOKEN=

# Or provide role-specific tokens for stronger separation.
CANTON_MAINTAINER_TOKEN=
CANTON_CONTRIBUTOR_TOKEN=
CANTON_VERIFIER_TOKEN=

# Optional GitHub token. Required while this repository is private.
GITHUB_TOKEN=

# Optional full-demo overrides.
COMMITLEDGER_ISSUE_URL=https://github.com/Saidur-droid/CommitLedger/issues/1
COMMITLEDGER_PR_NUMBER=2
COMMITLEDGER_CONTRIBUTOR_GITHUB=Saidur-droid
COMMITLEDGER_REWARD_AMOUNT=100
COMMITLEDGER_BASE_BRANCH=main
COMMITLEDGER_EVIDENCE_FILE=
